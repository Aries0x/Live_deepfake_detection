# =============================================================================
# Git Ignore Configuration - Media Integrity / Live Deepfake Detection
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Databases
*.db
*.sqlite
*.sqlite3
forensics.db

# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
frontend/.env.local
frontend/.env*.local

# Allow example environment files
!.env.example
!frontend/.env.local.example

# Temporary uploads & scratch files
temp_uploads/*
!temp_uploads/.gitkeep
scratch/*
!scratch/.gitkeep

# Large dataset files & heavy model checkpoints (>100MB)
data/
archive/
*.pt
*.pth
*.bin
*.onnx
*.tar
*.tar.gz
*.zip
*.7z
*.mp4
*.avi
*.mov
*.wav
*.m4a

# Frontend / Next.js
frontend/node_modules/
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
