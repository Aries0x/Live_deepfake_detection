# =============================================================================
# Media Integrity / SecureCall — Environment Configuration
# =============================================================================

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key
DEMO_MODE=false

# Device Configuration
# Options: cuda, cpu
DEVICE=cuda

# Database
DATABASE_URL=postgresql+asyncpg://securecall:securecall@localhost:5432/securecall

# Redis
REDIS_URL=redis://localhost:6379/0

# Video Analysis
VIDEO_SAMPLE_FPS=5
MAX_VIDEO_QUEUE_SIZE=10

# Audio Analysis
AUDIO_WINDOW_SECONDS=1.0
AUDIO_HOP_SECONDS=0.5
AUDIO_SAMPLE_RATE=16000
MAX_AUDIO_QUEUE_SIZE=20

# Model Configuration
ENABLE_ARCFACE=false
ENABLE_SECOND_VISUAL_MODEL=false
ENABLE_SECOND_AUDIO_MODEL=false
ENABLE_C2PA=true
ENABLE_STABILITY_TEST=true
ENABLE_HEAVY_MODELS=false
HEAVY_MODEL_TRIGGER=0.65

# Risk Thresholds
HIGH_RISK_THRESHOLD=0.80
ELEVATED_THRESHOLD=0.60
WATCH_THRESHOLD=0.40

# Risk State Machine
MIN_SUSPICIOUS_WINDOWS=3
MIN_MULTIMODAL_AGREEMENT=2
HIGH_RISK_DURATION=5.0
RECOVERY_DURATION=10.0

# Upload Limits
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=600
MAX_ZIP_EXTRACTION_MB=1000

# Privacy / Retention
# Options: ephemeral, 24h, 7d, permanent
RETENTION_MODE=ephemeral

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Batch Inference
BATCH_SIZE=4

# WebRTC STUN Server
STUN_SERVER=stun:stun.l.google.com:19302

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL (for frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
